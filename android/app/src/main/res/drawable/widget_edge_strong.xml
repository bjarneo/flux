<?xml version="1.0" encoding="utf-8"?>
<!-- The 2 dp red border of a widget row with an approval or a pair request, as the card in Chats. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- A shape with a color filter and no fill color draws an opaque fill, so the fill is clear. -->
    <solid android:color="@android:color/transparent" />
    <stroke android:width="2dp" android:color="@color/widget_red" />
    <corners android:radius="12dp" />
</shape>
