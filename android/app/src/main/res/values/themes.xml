<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window theme before Compose draws. The app is always dark, in the Tokyo Night background color. -->
    <style name="Theme.Flux" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/flux_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Flux.Translucent" parent="Theme.Flux">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
