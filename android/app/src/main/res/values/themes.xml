<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window theme before Compose draws, in the Tokyo Night background color.
        On Android 12 and later, the app sets its night mode, so the -night resources follow the theme of the app.
        With a computer theme, the night mode follows its mode, and TiledTheme sets the window background and the bar icons.
    -->
    <style name="Base.Theme.Flux" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/flux_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/flux_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/flux_light_bars</item>
    </style>

    <style name="Theme.Flux" parent="Base.Theme.Flux" />

    <!-- The main window. On Android 12 and later, its system splash screen shows the Flux mark. See values-v31. -->
    <style name="Theme.Flux.Main" parent="Theme.Flux" />

    <style name="Theme.Flux.Translucent" parent="Theme.Flux">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!--
        The clipboard sender window. It draws nothing, but it must take window
        focus, so it is not Theme.NoDisplay. It adds no dim and no animation,
        so the copy path shows no flicker.
    -->
    <style name="Theme.Flux.Invisible" parent="Theme.Flux">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
