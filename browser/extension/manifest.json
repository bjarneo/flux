{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.5.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "//": "The key fixes the extension ID, so that the native messaging host manifest that `flux-cli browser install` writes names the same extension in every Chromium browser.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/symbolic16.png",
      "48": "icons/symbolic48.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
